  "font_size": 14,
  "html": "<div class=\"prymage-gl-print\">\n\t<h2 style=\"text-align:center;margin-bottom:2px;\">Supplier Statement of Account</h2>\n\t<p style=\"text-align:center;margin-top:0;\">{{ filters.company  || '' }}</p>\n\t<table style=\"width:100%;margin-bottom:12px;\">\n\t\t<tr>\n\t\t\t<td><b>Supplier:</b> {{ filters.party  || '' }}</td>\n\t\t\t<td style=\"text-align:right;\"><b>Period:</b> {{ filters.from_date  || '' }} to {{ filters.to_date  || '' }}</td>\n\t\t</tr>\n\t</table>\n\t<table class=\"table table-bordered\" style=\"width:100%;border-collapse:collapse;\">\n\t\t<thead>\n\t\t\t<tr>\n\t\t\t\t<th style=\"border:1px solid #ccc;padding:4px;\">Date</th>\n\t\t\t\t<th style=\"border:1px solid #ccc;padding:4px;\">Voucher</th>\n\t\t\t\t<th style=\"border:1px solid #ccc;padding:4px;\">Against</th>\n\t\t\t\t<th style=\"border:1px solid #ccc;padding:4px;text-align:right;\">Debit</th>\n\t\t\t\t<th style=\"border:1px solid #ccc;padding:4px;text-align:right;\">Credit</th>\n\t\t\t\t<th style=\"border:1px solid #ccc;padding:4px;text-align:right;\">Balance</th>\n\t\t\t</tr>\n\t\t</thead>\n\t\t<tbody>\n\t\t\t{% for row in data %}\n\t\t\t<tr>\n\t\t\t\t<td style=\"border:1px solid #ccc;padding:4px;\">{{ row.posting_date  || '' }}</td>\n\t\t\t\t<td style=\"border:1px solid #ccc;padding:4px;\">{% if row.posting_date %}{{ row.voucher_type  || '' }} {{ row.voucher_no  || '' }}{% else %}<b>{{ (row.account || '').replace(/^'+|'+$/g, '') }}</b>{% endif %}</td>\n\t\t\t\t<td style=\"border:1px solid #ccc;padding:4px;\">{{ row.against  || '' }}</td>\n\t\t\t\t<td style=\"border:1px solid #ccc;padding:4px;text-align:right;\">{{ row.debit  || '' }}</td>\n\t\t\t\t<td style=\"border:1px solid #ccc;padding:4px;text-align:right;\">{{ row.credit  || '' }}</td>\n\t\t\t\t<td style=\"border:1px solid #ccc;padding:4px;text-align:right;\">{{ row.balance  || '' }}</td>\n\t\t\t</tr>\n\t\t\t{% endfor %}\n\t\t</tbody>\n\t</table>\n</div>\n\n",
  "line_breaks": 0,
  "margin_bottom": 15.0,
  "margin_left": 15.0,
  "margin_right": 15.0,
  "margin_top": 15.0,
